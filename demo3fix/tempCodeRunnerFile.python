# Define pure functions for each button's functionality
def handle_home_action():
    return "Home selected"

def handle_transaksi_action():
    return "Transaksi selected"

def handle_notifikasi_action():
    return "Notifikasi selected"

def handle_akun_action():
    return "Akun Saya selected"

# Example usage
